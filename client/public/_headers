# Caching strategy (Netlify / Cloudflare Pages format).
# Adapt to the chosen host (e.g. vercel.json headers or server config) when deploying.

# Hashed build output (JS, CSS, fonts) — safe to cache forever.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/static/*
  Cache-Control: public, max-age=31536000, immutable

# Un-hashed public media — cache for a week, revalidate afterwards.
/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML must always revalidate so new deployments are picked up immediately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/index.html
  Cache-Control: public, max-age=0, must-revalidate
