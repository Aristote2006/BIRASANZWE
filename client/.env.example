# Copy to `.env.local` and fill in official values when available.

# Official WhatsApp number in international format, digits only (no +, spaces or dashes).
# Defaults to 250790378355 (+250 790 378 355).
VITE_WHATSAPP_NUMBER=250790378355

# Public production URL of the website (used for canonical / SEO references).
VITE_SITE_URL=https://www.example.org
